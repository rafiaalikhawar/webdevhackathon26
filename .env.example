# Copy to .env locally. Never commit real values.
DATABASE_URL=postgresql://relay_app:REPLACE_WITH_RUNTIME_PASSWORD@localhost:5432/relay
MIGRATION_DATABASE_URL=postgresql://relay_owner:REPLACE_WITH_OWNER_PASSWORD@localhost:5432/relay
APP_ORIGIN=http://localhost:5173
PORT=3001
NODE_ENV=development
# Provider integrations are intentionally not enabled in this foundation release.
# API credentials will be configured server-side when adapters are implemented.
# 32-byte hex key used to encrypt provider secrets at rest (openssl rand -hex 32). Required for integrations.
SECRETS_KEY=
# Public HTTPS base URL that providers call (tunnel or deployment). Webhook signatures are computed against it.
PUBLIC_BASE_URL=https://your-tunnel.example.com
# Optional shared Google OAuth app (per-workspace credentials can be entered in the UI instead)
